<resources>
    <string name="app_name">VirtualGamepad</string>

    <!-- Title of the dialog that allows the user to configure the gamepad
         style and size. -->
    <string name="gamepad_style">Gamepad Style</string>
    <!-- Label for the theme-toggle in the gamepad configuration dialog (such as light/dark
         theme). -->
    <string name="gamepad_theme">Theme</string>
    <!-- Names of the different themes we have for the virtual gamepad. -->
    <string-array name="gamepad_theme_items">
        <item>Light</item>
        <item>Dark</item>
    </string-array>
    <!-- Label of the drop down option for the gamepad layout/style
         (e.g., "Twin-stick, inline" layout). -->
    <string name="label_gamepad_style">Gamepad Style</string>
    <!-- Names of the different styles we have for the virtual gamepad.  They describe the
         gamepad by the button layout, e.g. two directional sticks->'twin-sticks' and their
         positions. -->
    <string-array name="gamepad_style_items">
        <!-- Represents a gamepad layout with two joysticks positioned side-by-side/symmetrically. -->
        <item>Twin stick, Inline</item>
        <!-- Represents a gamepad layout with two joysticks where one is positioned higher
             than the other in an offset fashion. -->
        <item>Twin stick, Staggered</item>
    </string-array>
    <!-- Label for the drop-down options for selecting the size of the gamepad. A smaller size
         would bring the buttons closer together and closer to the edge to accommodate smaller
         hand sizes. -->
    <string name="label_gamepad_size">Size</string>
    <!-- Names of the options for different gamepad sizes. -->
    <string-array name="gamepad_size_items">
        <item>Small</item>
        <item>Medium</item>
        <item>Large</item>
    </string-array>

    <!-- The option to enable or disable  haptics -->
    <string name="description_haptics">Haptics Setting</string>
    <!-- The button descriptor for a virtual gamepad. e.g., Used with accessibility. -->
    <string name="description_mode_button">Mode button</string>

    <!-- Describes the left joystick of a virtual gamepad. e.g., Used with accessibility. -->
    <string name="description_left_joystick">Left Joystick</string>
    <!-- Describes the right joystick of a virtual gamepad. e.g., Used with accessibility. -->
    <string name="description_right_joystick">Right Joystick</string>

    <!-- Description for game button A. Used with accessibility. -->
    <string name="description_game_button_a">A Button</string>
    <!-- Description for game button B. Used with accessibility. -->
    <string name="description_game_button_b">B Button</string>
    <!-- Description for game button X. Used with accessibility. -->
    <string name="description_game_button_x">X Button</string>
    <!-- Description for game button Y. Used with accessibility. -->
    <string name="description_game_button_y">Y Button</string>
    <!-- Description for game button L1. Used with accessibility. -->
    <string name="description_game_button_l1">L1 Button</string>
    <!-- Description for game button L2. Used with accessibility. -->
    <string name="description_game_button_l2">L2 Button</string>
    <!-- Description for game button L3. Used with accessibility. -->
    <string name="description_game_button_l3">L3 Button</string>
    <!-- Description for game button R1. Used with accessibility. -->
    <string name="description_game_button_r1">R1 Button</string>
    <!-- Description for game button R2. Used with accessibility. -->
    <string name="description_game_button_r2">R2 Button</string>
    <!-- Description for game button R3. Used with accessibility. -->
    <string name="description_game_button_r3">R3 Button</string>
    <!-- Description for game button DPAD UP. Used with accessibility. -->
    <string name="description_game_button_dpad_up">D-pad Up</string>
    <!-- Description for game button DPAD DOWN. Used with accessibility. -->
    <string name="description_game_button_dpad_down">D-pad Down</string>
    <!-- Description for game button DPAD LEFT. Used with accessibility. -->
    <string name="description_game_button_dpad_left">D-pad Left</string>
    <!-- Description for game button DPAD RIGHT. Used with accessibility. -->
    <string name="description_game_button_dpad_right">D-pad Right</string>
    <!-- Description for game button Menu. Used with accessibility. -->
    <string name="description_game_button_menu">Menu Button</string>
    <!-- Description for game button Settings. Used with accessibility. -->
    <string name="description_game_button_settings">Settings Button</string>

    <!-- Describes the drop down menu for the gamepad style -->
    <string name="description_gamepad_style_selector">Choose Gamepad Style</string>

    <!-- Describes the drop down menu for the gamepad size -->
    <string name="description_gamepad_size_selector">Choose Gamepad Size</string>

    <!-- Description to hide the gamepad from the game UI -->
    <string name="description_hide_gamepad">Hide Gamepad</string>
    <!-- Dismisses the gamepad from the game UI -->
    <string name="hide_gamepad">Hide Gamepad</string>
    <!-- Describes opening the gamepad style menu.-->
    <string name="description_gamepad_style">Open gamepad style menu.</string>
    <!-- Formats the gamepad style as <type> | <size> if relevant we might reverse the order.-->
    <string name="template_gamepad_style_text">%1$s | %2$s</string>
    <!-- Haptics for a gamepad -->
    <string name="haptics">Haptics</string>
    <!-- Says that a switch is checked or on -->
    <string name="description_checked">Checked</string>
    <!-- Hide the gamepad temporarily. The gamepad will show again when the game is launched next
         time. -->
    <string name="hide_for_now">Hide for now</string>
    <string name="always_hide">Always hide for this game</string>
    <string name="hide_gamepad_title">Hide the virtual gamepad?</string>
</resources>
